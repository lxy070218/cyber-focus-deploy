# ============================================================
# Cyber Focus Backend - systemd 服务单元
# 保证 uvicorn 进程崩溃后自动重启
# 部署路径：/etc/systemd/system/cyber-focus-backend.service
# 启用命令：
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cyber-focus-backend.service
# ============================================================

[Unit]
Description=Cyber Focus Backend (FastAPI + Uvicorn)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data

# 工作目录与虚拟环境
WorkingDirectory=/opt/cyber-focus/backend
Environment="PATH=/opt/cyber-focus/backend/venv/bin:/usr/local/bin:/usr/bin"
EnvironmentFile=-/opt/cyber-focus/backend/.env

# 启动命令：uvicorn 监听 127.0.0.1:8000
ExecStart=/opt/cyber-focus/backend/venv/bin/uvicorn main:app \
          --host 127.0.0.1 \
          --port 8000 \
          --workers 2

# 崩溃自动重启：3 秒后重试，无限次
Restart=always
RestartSec=3
StartLimitInterval=0

# 日志输出到 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cyber-focus-backend

# 安全加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
